# Keep the build context small and avoid leaking local state into images.

# VCS and agent/worktree state
.git
.gitignore
.worktrees
.claude
.idea
.vscode

# Obsidian vault / tooling state (the repo doubles as a vault)
.obsidian
.vault-meta

# Build artifacts and task cache
/rss2msg
/bin
/tmp
.task

# Local state store (SQLite) — never bake into an image
*.db
*.db-*

# Test / coverage output
*.test
*.out
coverage.txt

# Secrets and local-only config
.env
.envrc
/config.yaml

# Docs and tests aren't needed to compile ./cmd/rss2msg
docs
test
