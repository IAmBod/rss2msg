# Dockerfile used by GoReleaser only.
#
# GoReleaser compiles the binary on the host (see builds: in .goreleaser.yaml)
# and this image just packages the prebuilt `rss2msg` onto the same distroless
# base the hand-written Dockerfile's production stage uses. Do NOT `go build`
# here — the binary already exists in the build context.
FROM gcr.io/distroless/static-debian12:nonroot
COPY rss2msg /usr/local/bin/rss2msg
# Config is resolved from --config, then ./config.yaml, then /etc/rss2msg/config.yaml.
EXPOSE 8080 9090
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/rss2msg"]
CMD ["serve"]
