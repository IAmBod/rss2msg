# Dockerfile used by GoReleaser (dockers_v2) only.
#
# GoReleaser compiles the binary on the host (see builds: in .goreleaser.yaml)
# and this image just packages the prebuilt `rss2msg` onto the same distroless
# base the hand-written Dockerfile's production stage uses. Do NOT `go build`
# here — the binary already exists in the build context.
#
# dockers_v2 builds one multi-platform image with buildx and lays the binaries
# out under per-platform subdirectories (e.g. linux/amd64/rss2msg), so the COPY
# must select the right one via the buildx-provided $TARGETPLATFORM build arg.
FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/rss2msg /usr/local/bin/rss2msg
# Config is resolved from --config, then ./config.yaml, then /etc/rss2msg/config.yaml.
EXPOSE 8080 9090
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/rss2msg"]
CMD ["serve"]
