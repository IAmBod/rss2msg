# Build artifacts
/rss2msg
/bin/
# GoReleaser output
/dist/
# Release notes generated by git-cliff in the release workflow — keeping this
# untracked file out of git's view is what lets `goreleaser release` see a clean
# tree (https://goreleaser.com/errors/dirty).
/RELEASE_NOTES.md

# State store (SQLite)
/rss2msg.db
/rss2msg.db-*

# Test / coverage output
*.test
*.out
coverage.txt

# Environment / secrets
.envrc
.env

# Local working config (copy from examples/config.example.yaml or examples/config.example.full.yaml)
/config.yaml

# Editors / build tooling state
.idea/
.vscode/
.task/

# Obsidian vault config + plugins (repo doubles as a vault; local-only)
.obsidian/

# Claude+Obsidian tooling state — generated per-machine (absolute paths), not source
.vault-meta/

# Claude Code tooling state (settings) — local-only
.claude/

# Git worktrees (per AGENTS.md, worktrees live under .worktrees/)
.worktrees/
